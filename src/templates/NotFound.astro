---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../i18n/config';
import { notFound } from '../i18n/pages/not-found';

// Volontairement sans `route` : la page n'est pas dans ROUTES, donc Seo omet
// canonical et hreflang et pose noindex, et le lien de langue d'en-tête
// retombe sur l'accueil plutôt que sur un /en/404 inexistant.
const fr = notFound.fr;
const en = notFound.en;
---

<BaseLayout title={fr.meta.title} description={fr.meta.description} locale="fr">
  <div class="mx-auto max-w-[68rem] px-5 pt-16 pb-14 sm:px-8 sm:pt-24">
    <p class="label text-muted">{fr.eyebrow}</p>
    <p class="display mt-4 text-hero" aria-hidden="true">404</p>
    <div class="rule mt-6" aria-hidden="true"></div>
    <h1 class="mt-6 text-h2">{fr.title}</h1>
    <p class="mt-5 max-w-[52ch] text-lede text-muted">{fr.body}</p>
    <ul class="mt-10 flex flex-wrap gap-4">
      <li>
        <a href={url('fr', 'home')} class="btn btn-solid">{fr.home}</a>
      </li>
      <li>
        <a href={url('fr', 'lab')} class="btn btn-line">{fr.ledger}</a>
      </li>
      <li>
        <a href={url('fr', 'contact')} class="btn btn-line">{fr.contact}</a>
      </li>
    </ul>
  </div>

  <section lang="en" class="border-t border-rule bg-chalk px-5 py-12 sm:px-8">
    <div class="mx-auto max-w-[68rem]">
      <p class="label text-muted">{en.eyebrow}</p>
      <h2 class="mt-3 max-w-[30ch] text-h3">{en.title}</h2>
      <p class="mt-4 max-w-[52ch] text-[0.98rem] text-muted">{en.body}</p>
      <ul class="mt-7 flex flex-wrap gap-x-8 gap-y-3">
        <li>
          <a href={url('en', 'home')} hreflang="en" class="link-underline text-ink">{en.home}</a>
        </li>
        <li>
          <a href={url('en', 'lab')} hreflang="en" class="link-underline text-ink">{en.ledger}</a>
        </li>
        <li>
          <a href={url('en', 'contact')} hreflang="en" class="link-underline text-ink">{en.contact}</a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .rule {
    height: 3px;
    background: var(--accent);
  }
</style>
