---
import BaseLayout from '../layouts/BaseLayout.astro';
import PoleHero from '../components/PoleHero.astro';
import Section from '../components/Section.astro';
import { url, type Locale } from '../i18n/config';
import { consulting } from '../i18n/pages/consulting';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = consulting[locale];
---

<BaseLayout title={c.meta.title} description={c.meta.description} {locale} route="consulting" pole="consulting">
  <PoleHero eyebrow={c.hero.eyebrow} title={c.hero.title} lede={c.hero.lede}>
    <a href={url(locale, 'contact')} class="btn btn-solid">{c.hero.primary}</a>
    <a href={url(locale, 'home')} class="btn btn-line">{c.hero.secondary}</a>
  </PoleHero>

  <Section id="offres" eyebrow={c.offers.eyebrow} title={c.offers.title} size="wide" class="mt-8">
    <ul class="grid gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3">
      {
        c.offers.items.map((offer) => (
          <li class="bg-chalk py-7 pr-6 pl-0">
            <p class="label pl-6 text-accent-ink">{offer.name}</p>
            <p class="mt-3 max-w-[36ch] pl-6 text-[0.98rem] text-muted">{offer.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="ink" size="wide">
    <div class="grid gap-8 lg:grid-cols-[auto_1fr] lg:gap-16">
      <h2 class="max-w-[20ch] text-h3 text-chalk">{c.audiences.title}</h2>
      <div>
        <p class="label text-chalk/55">{c.audiences.eyebrow}</p>
        <p class="mt-4 max-w-[62ch] text-chalk/80">{c.audiences.body}</p>
      </div>
    </div>
  </Section>

  <Section id="deroule" eyebrow={c.process.eyebrow} title={c.process.title} size="wide">
    <p class="mb-12 max-w-[62ch] text-lede text-muted">{c.process.intro}</p>
    <ol class="steps">
      {
        c.process.steps.map((step, i) => (
          <li class="step">
            <span class="label step-n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-h3">{step.title}</h3>
              <p class="mt-2 max-w-[44ch] text-[0.98rem] text-muted">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="tarification" eyebrow={c.pricing.eyebrow} title={c.pricing.title} size="wide">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <p class="max-w-[62ch] text-lede text-ink">{c.pricing.body}</p>
      <div>
        <p class="max-w-[40ch] border-l border-rule pl-5 text-[0.95rem] text-muted">{c.pricing.note}</p>
        <p class="mt-8">
          <a href={url(locale, 'contact')} class="btn btn-solid">{c.hero.primary}</a>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .steps {
    display: grid;
    gap: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .step {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 1.15rem;
    align-items: start;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .step-n {
    padding-top: 0.42rem;
    color: var(--accent-ink);
  }

  @media (min-width: 52rem) {
    .steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 0 1.4rem;
    }

    .step {
      grid-template-columns: 1fr;
      gap: 0;
      border-bottom: 0;
      padding-bottom: 1.2rem;
    }

    .step-n {
      padding-top: 0;
      margin-bottom: 1.1rem;
    }
  }
</style>
