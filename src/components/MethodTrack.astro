---
import type { BUILD_STEPS } from '../i18n/method';
import type { Locale } from '../i18n/config';

interface Props {
  steps: (typeof BUILD_STEPS)[Locale];
  /** libellé du rail, lu par la technologie d'assistance */
  railLabel: string;
}

const { steps, railLabel } = Astro.props;
const nums = ['01', '02', '03', '04'];
---

<div class="track" data-reveal>
  <p class="sr-only">{railLabel}</p>
  <div class="rail" aria-hidden="true">
    <span class="rail-fill"></span>
    <ul class="rail-marks">
      {steps.map((step, i) => <li class="rail-mark" style={`--i: ${i}`}>{step.mark}</li>)}
    </ul>
  </div>

  <ol class="steps">
    {
      steps.map((step, i) => (
        <li class="step" data-reveal style={`--d: ${i * 110}ms`}>
          <p class="step-num label">
            {nums[i]} <span class="step-mark">{step.mark}</span>
          </p>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-body">{step.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .track {
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  .rail {
    position: relative;
    height: 1px;
    background: var(--color-rule);
  }

  /* Le remplissage suit la progression réelle du visiteur dans la section.
     Sans `animation-timeline`, le rail reste simplement complet : rien ne
     se casse, l'information est dans les étapes. */
  .rail-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: var(--accent-ink);
    transform-origin: left center;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rail-fill {
        animation: rail-grow linear both;
        animation-timeline: view(block);
        animation-range: entry 25% cover 55%;
      }
    }
  }

  @keyframes rail-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .rail-marks {
    position: absolute;
    inset: -0.45rem 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    list-style: none;
  }

  .rail-mark {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--color-muted);
    background: var(--color-chalk);
    padding-right: 0.5rem;
    width: fit-content;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-rule);
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  @media (max-width: 61.99rem) {
    .rail {
      display: none;
    }
    .steps {
      grid-template-columns: 1fr;
    }
  }

  .step {
    background: var(--color-chalk);
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.6rem 1.4rem 2rem;
  }

  .step-num {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    color: var(--accent-ink);
  }

  .step-mark {
    color: var(--color-muted);
    letter-spacing: 0.14em;
  }

  .step-title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .step-body {
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 34ch;
  }

  @media (min-width: 62rem) {
    .step {
      min-height: 15rem;
    }
    .step:hover .step-title {
      color: var(--accent-ink);
    }
    .step-title {
      transition: color 200ms ease-out;
    }
  }
</style>
