---
import { url, type Locale } from '../i18n/config';

interface Mode {
  name: string;
  body: string;
}

interface Props {
  locale: Locale;
  modes: Mode[];
  cta: string;
}

const { locale, modes, cta } = Astro.props;
---

<div class="ways-to">
  <ul class="mode-list">
    {
      modes.map((mode, i) => (
        <li data-reveal style={`--d: ${i * 80}ms`}>
          <a class="mode" href={url(locale, 'contact')}>
            <span class="mode-name">{mode.name}</span>
            <span class="mode-body">{mode.body}</span>
            <span class="label mode-go" aria-hidden="true">
              <svg viewBox="0 0 16 10" class="mode-arrow" fill="none">
                <path d="M0 5h14M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mode-cta" data-reveal>
    <a href={url(locale, 'contact')} class="btn btn-solid">{cta}</a>
  </p>
</div>

<style>
  .ways-to {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .mode-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-rule);
    list-style: none;
    border-block: 1px solid var(--color-rule);
  }

  @media (max-width: 47.99rem) {
    .mode-list {
      grid-template-columns: 1fr;
    }
  }

  .mode {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    background: var(--color-chalk);
    padding: 1.7rem 1.6rem 1.9rem;
    min-height: 9.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 200ms ease-out;
  }

  .mode:hover,
  .mode:focus-visible {
    background: var(--accent-wash);
  }

  .mode-name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.018em;
    text-transform: uppercase;
  }

  .mode-body {
    grid-column: 1 / -1;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 38ch;
  }

  .mode-go {
    grid-row: 1;
    grid-column: 2;
    color: var(--accent-ink);
  }

  .mode-arrow {
    width: 16px;
    height: 10px;
    transition: transform 240ms ease-out;
  }

  .mode:hover .mode-arrow,
  .mode:focus-visible .mode-arrow {
    transform: translateX(5px);
  }

  .mode-cta {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .mode,
    .mode-arrow {
      transition: none;
    }
  }
</style>
