---
import { url, type Locale, type Pole } from '../i18n/config';
import { poles } from '../i18n/poles';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** phrase d'accroche au-dessus des bandes, propre à la page */
  hint?: string;
}

const { locale, hint } = Astro.props;
const s = t(locale);
const p = poles[locale];

const items: { key: Pole; route: 'consulting' | 'lab' | 'studio' }[] = [
  { key: 'consulting', route: 'consulting' },
  { key: 'lab', route: 'lab' },
  { key: 'studio', route: 'studio' },
];
---

<div class="bands" data-bands>
  {hint && <p class="label bands-hint">{hint}</p>}
  <ul class="bands-list">
    {
      items.map(({ key, route }, i) => (
        <li class="band-item" data-reveal style={`--d: ${i * 90}ms`}>
          <a href={url(locale, route)} class="band" data-p={key}>
            <span class="band-side label" aria-hidden="true">
              {p[key].name}
            </span>
            <span class="band-body">
              <span class="band-top">
                <span class="display band-name">{s.nav[key]}</span>
                <svg class="band-glyph" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                  {
                    p[key].glyph === 'grid' ? (
                      <g>
                        <rect x="1" y="1" width="30" height="30" stroke="currentColor" stroke-width="1" opacity="0.4" />
                        <circle cx="8" cy="8" r="1.6" fill="currentColor" />
                        <circle cx="16" cy="8" r="1.6" fill="currentColor" />
                        <circle cx="24" cy="8" r="1.6" fill="currentColor" />
                        <circle cx="8" cy="16" r="1.6" fill="currentColor" />
                        <circle cx="16" cy="16" r="1.6" fill="currentColor" />
                        <circle cx="24" cy="16" r="1.6" fill="currentColor" />
                        <circle cx="8" cy="24" r="1.6" fill="currentColor" />
                        <circle cx="16" cy="24" r="1.6" fill="currentColor" />
                        <circle cx="24" cy="24" r="1.6" fill="currentColor" />
                      </g>
                    ) : p[key].glyph === 'network' ? (
                      <g>
                        <path
                          d="M6 26 L16 6 L26 20 M16 6 L26 20 L6 26"
                          stroke="currentColor"
                          stroke-width="1"
                          opacity="0.45"
                        />
                        <circle cx="16" cy="6" r="2.4" fill="currentColor" />
                        <circle cx="6" cy="26" r="2.4" fill="var(--color-chalk)" stroke="currentColor" stroke-width="1" />
                        <circle cx="26" cy="20" r="2.4" fill="var(--color-chalk)" stroke="currentColor" stroke-width="1" />
                      </g>
                    ) : (
                      <g>
                        <circle cx="5" cy="27" r="2.2" fill="currentColor" />
                        <path d="M5 20 A 8 8 0 0 1 12 27" stroke="currentColor" stroke-width="1.2" fill="none" />
                        <path d="M5 13 A 15 15 0 0 1 19 27" stroke="currentColor" stroke-width="1.2" fill="none" opacity="0.6" />
                        <path d="M5 6 A 22 22 0 0 1 27 27" stroke="currentColor" stroke-width="1.2" fill="none" opacity="0.3" />
                      </g>
                    )
                  }
                </svg>
              </span>
              <span class="band-promise">{p[key].promise}</span>
              <span class="band-role">{p[key].body}</span>
              <span class="band-skills">
                {p[key].skills.map((skill) => <span class="skill">{skill}</span>)}
              </span>
              <span class="label band-go" aria-hidden="true">
                {s.cta.discover}
                <svg viewBox="0 0 16 10" class="band-arrow" fill="none" aria-hidden="true">
                  <path d="M0 5h14M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .bands {
    display: grid;
    gap: 1rem;
  }

  .bands-hint {
    color: var(--color-muted);
  }

  .bands-list {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 60rem) {
    .bands-list {
      grid-template-columns: repeat(3, 1fr);
      transition: grid-template-columns 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
  }

  .band-item {
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 60rem) {
    .band-item {
      border-bottom: 0;
      border-right: 1px solid var(--color-rule);
    }
    .band-item:last-child {
      border-right: 0;
    }
    /* La bande survolée prend de la place : le trio reste à égalité au repos,
       et l'une d'elles seulement s'impose le temps du regard. */
    .bands-list:has(.band-item:nth-child(1):hover) {
      grid-template-columns: 1.4fr 0.8fr 0.8fr;
    }
    .bands-list:has(.band-item:nth-child(2):hover) {
      grid-template-columns: 0.8fr 1.4fr 0.8fr;
    }
    .bands-list:has(.band-item:nth-child(3):hover) {
      grid-template-columns: 0.8fr 0.8fr 1.4fr;
    }
  }

  .band {
    --band: var(--color-cobalt);
    --band-ink: var(--color-cobalt);
    display: flex;
    align-items: stretch;
    min-height: 12rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background: transparent;
    transition: background-color 260ms ease-out;
  }

  @media (min-width: 60rem) {
    .band {
      min-height: 24rem;
    }
  }

  .band[data-p='lab'] {
    --band: var(--color-verdigris);
    --band-ink: var(--color-verdigris);
  }

  /* L'ocre plein ne contraste que 2,7:1 sur craie : il reste réservé aux
     aplats, et le texte prend son jumeau foncé. */
  .band[data-p='studio'] {
    --band: var(--color-ocre);
    --band-ink: var(--color-ocre-ink);
  }

  .band:hover,
  .band:focus-visible {
    background: color-mix(in oklab, var(--band) 9%, var(--color-chalk));
  }

  .band-side {
    display: none;
    writing-mode: vertical-rl;
    /* lecture bas -> haut, comme une tranche de reliure */
    transform: rotate(180deg);
    padding: 1.1rem 0.45rem;
    border-right: 1px solid var(--color-rule);
    color: var(--band-ink);
    white-space: nowrap;
  }

  @media (min-width: 60rem) {
    .band-side {
      display: block;
    }
  }

  .band-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem 1.6rem;
    min-width: 0;
    flex: 1;
  }

  @media (min-width: 60rem) {
    .band-body {
      padding: 1.8rem 1.9rem 2rem;
    }
  }

  .band-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .band-name {
    font-size: clamp(1.9rem, 4.4vw, 3.1rem);
    color: var(--color-ink);
  }

  .band-glyph {
    width: 32px;
    height: 32px;
    flex: none;
    color: var(--band-ink);
    opacity: 0.85;
    transition: transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .band:hover .band-glyph,
  .band:focus-visible .band-glyph {
    transform: translateY(-3px);
  }

  .band-promise {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100;
    font-size: 1.02rem;
    line-height: 1.35;
    color: var(--band-ink);
    max-width: 30ch;
  }

  .band-role {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 34ch;
  }

  .band-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.3rem;
  }

  .skill {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    padding: 0.25rem 0.45rem;
    transition: border-color 200ms ease-out;
  }

  .band:hover .skill {
    border-color: color-mix(in oklab, var(--band) 45%, var(--color-rule));
  }

  .band-go {
    margin-top: auto;
    padding-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--band-ink);
  }

  .band-arrow {
    width: 16px;
    height: 10px;
    transition: transform 240ms ease-out;
  }

  .band:hover .band-arrow,
  .band:focus-visible .band-arrow {
    transform: translateX(5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .band-arrow,
    .band-glyph,
    .bands-list,
    .skill {
      transition: none;
    }
  }
</style>
