---
import { url, type Locale } from '../i18n/config';
import { poles } from '../i18n/poles';
import { t } from '../i18n/ui';
import { EMAIL, SOCIAL } from '../social';

const { locale } = Astro.props as { locale: Locale };
const s = t(locale);
const p = poles[locale];
const year = new Date().getFullYear();

const nav = [
  { href: url(locale, 'about'), text: s.nav.about },
  { href: url(locale, 'consulting'), text: p.consulting.name },
  { href: url(locale, 'lab'), text: p.lab.name },
  { href: url(locale, 'studio'), text: p.studio.name },
  { href: `${url(locale, 'lab')}#carnet`, text: s.footer.projects },
  { href: `${url(locale, 'home')}#collaborer`, text: s.footer.collaborate },
  { href: url(locale, 'contact'), text: s.nav.contact },
];
---

<footer class="foot">
  <div class="mx-auto max-w-[88rem] px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-20">
      <div>
        <p class="foot-mark display">iNOVA BENIN</p>
        <p class="mt-3 text-[1.05rem] text-chalk/75">{s.tagline}.</p>
        <p class="rhythm label">{s.footer.rhythm}</p>
        <a class="foot-mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>

      <nav aria-labelledby="f-site">
        <h2 id="f-site" class="label text-chalk/55">{s.footer.sitemap}</h2>
        <ul class="foot-nav">
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.text}</a>
              </li>
            ))
          }
        </ul>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {
            SOCIAL.map((profile) => (
              <li class="flex items-baseline gap-2">
                <a
                  href={profile.href}
                  rel="me noopener"
                  target="_blank"
                  class="label link-underline"
                >
                  {profile.label}
                </a>
                {profile.person && <span class="foot-who">{profile.person}</span>}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="foot-base">
      <p class="label">{s.status}</p>
      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <li>
          <a href={url(locale, 'legal')} class="label link-underline">{s.footer.legal}</a>
        </li>
        <li>
          <a href={url(locale, 'privacy')} class="label link-underline">{s.footer.privacy}</a>
        </li>
        <li class="label text-chalk/55">
          © {year} iNOVA BENIN. {s.footer.rights}
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: 6rem;
    background: var(--color-ink);
    color: var(--color-chalk);
  }

  .foot-mark {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    letter-spacing: -0.02em;
  }

  /* Le refrain du site, répété tel quel : ni reformulé, ni écourté. */
  .rhythm {
    margin-top: 1.6rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(242 240 234 / 0.16);
    color: var(--color-chalk);
    font-size: 0.78rem;
  }

  .foot-mail {
    display: inline-block;
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100;
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    letter-spacing: -0.01em;
    color: var(--color-chalk);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    word-break: break-word;
  }

  .foot-mail:hover,
  .foot-mail:focus-visible {
    text-decoration-thickness: 2px;
  }

  .foot-nav {
    margin-top: 1rem;
    display: grid;
    gap: 0.15rem;
  }

  @media (min-width: 40rem) {
    .foot-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  .foot-nav a {
    display: block;
    padding: 0.42rem 0;
    border-bottom: 1px solid rgb(242 240 234 / 0.1);
    color: rgb(242 240 234 / 0.88);
  }

  .foot-nav a:hover,
  .foot-nav a:focus-visible {
    color: var(--color-chalk);
    border-bottom-color: var(--color-chalk);
  }

  .foot-who {
    color: rgb(242 240 234 / 0.5);
    font-size: 0.82rem;
  }

  .foot-base {
    margin-top: 3.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(242 240 234 / 0.16);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem 2rem;
    color: rgb(242 240 234 / 0.6);
  }

  .foot-base a {
    color: rgb(242 240 234 / 0.75);
  }

  .foot-base a:hover,
  .foot-base a:focus-visible {
    color: var(--color-chalk);
  }
</style>
