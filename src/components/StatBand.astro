---
interface Item {
  /** La valeur réelle, jamais sa copie formatée : le zéro de tête est un choix d'écriture. */
  value: number;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<dl class="stats">
  {
    items.map((item) => (
      <div class="stat">
        <dt class="label stat-label">{item.label}</dt>
        <dd class="display stat-num" data-count={item.value}>{pad(item.value)}</dd>
      </div>
    ))
  }
</dl>

<style>
  /* Le chiffre est la vedette (§3) : il se pose avant son étiquette, et le
     HTML garde la valeur finale — l'animation ne fait que le compter. */
  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-rule);
    border-top: 3px solid var(--color-ink);
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat {
    background: var(--color-chalk);
    display: grid;
    grid-template-rows: auto auto;
    align-content: center;
    gap: 0.2rem;
    padding: clamp(1.4rem, 3vw, 2.4rem) clamp(0.4rem, 2vw, 1.2rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .stat-num {
    grid-row: 1;
    font-size: clamp(3.4rem, 9vw, 7rem);
    font-variation-settings: 'wdth' 118;
    line-height: 0.82;
    letter-spacing: -0.05em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    grid-row: 2;
    color: var(--color-muted);
  }
</style>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');
  const cells = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function count(el: HTMLElement) {
    const target = Number(el.dataset.count);
    if (!Number.isFinite(target)) return;
    const start = performance.now();
    const frame = (now: number) => {
      const p = Math.min(1, (now - start) / 900);
      el.textContent = pad(Math.round(target * (1 - (1 - p) ** 3)));
      if (p < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  // Hors animation, ou sans observateur, la valeur déjà écrite dans le HTML
  // reste telle quelle : rien n'est jamais retiré de l'écran pour être remplacé.
  if (cells.length && !reduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          count(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.3 },
    );
    cells.forEach((cell) => io.observe(cell));
  }
</script>
