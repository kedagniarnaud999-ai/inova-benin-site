---
import { url, type Locale, type Pole, type RouteKey } from '../i18n/config';
import { t } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  /** absent sur une page sans équivalent dans l'autre langue (404) */
  route?: RouteKey;
}

const { locale, route } = Astro.props;
const s = t(locale);
const other: Locale = locale === 'fr' ? 'en' : 'fr';
const otherHref = url(other, route ?? 'home');

const items: { key: RouteKey; label: string; accent?: Pole }[] = [
  { key: 'consulting', label: s.nav.consulting, accent: 'consulting' },
  { key: 'lab', label: s.nav.lab, accent: 'lab' },
  { key: 'studio', label: s.nav.studio, accent: 'studio' },
  { key: 'about', label: s.nav.about },
  { key: 'contact', label: s.nav.contact },
];
---

<header class="head" data-head>
  <div class="head-row mx-auto flex max-w-[88rem] items-center gap-6 px-5 py-4 sm:px-8">
    <a
      href={url(locale, 'home')}
      class="head-brand display shrink-0 py-1 text-[1.15rem] leading-none"
    >
      iNOVA<span class="text-accent-ink">·</span>SPACE
    </a>

    <nav aria-label={s.nav.main} class="ml-auto hidden lg:block">
      <ul class="flex items-baseline gap-7">
        {
          items.map((item) => {
            const active = item.key === route;
            return (
              <li>
                <a
                  href={url(locale, item.key)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'label inline-flex items-center gap-2 py-1 text-ink transition-colors hover:text-accent-ink',
                    active && 'text-accent-ink',
                  ]}
                >
                  {item.accent && (
                    <span
                      aria-hidden="true"
                      class:list={[
                        'size-[5px] rounded-full',
                        item.accent === 'consulting' && 'bg-cobalt dark:bg-cobalt-lift',
                        item.accent === 'lab' && 'bg-verdigris dark:bg-verdigris-lift',
                        item.accent === 'studio' && 'bg-ocre dark:bg-ocre-lift',
                      ]}
                    />
                  )}
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="head-actions ml-auto flex items-center gap-3 lg:ml-0">
      <a href={url(locale, 'contact')} class="head-cta btn btn-solid hidden lg:inline-flex">
        {s.nav.build}
      </a>
      <ThemeToggle {locale} />
      <a
        href={otherHref}
        hreflang={other}
        lang={other}
        class="head-chip label border border-rule px-2.5 py-1.5 text-ink transition-colors hover:border-accent-ink hover:text-accent-ink"
      >
        {other.toUpperCase()}
        <span class="sr-only">· {s.nav.language}</span>
      </a>

      <details class="relative lg:hidden">
        <summary
          class="head-chip label flex cursor-pointer list-none items-center gap-2 border border-rule px-3 py-2 select-none"
        >
          {s.nav.menu}
        </summary>
        <ul class="absolute right-0 z-50 mt-1 w-56 border border-rule bg-chalk p-2 shadow-lg">
          {
            items.map((item) => (
              <li>
                <a
                  href={url(locale, item.key)}
                  aria-current={item.key === route ? 'page' : undefined}
                  class="label block px-3 py-2 text-ink hover:bg-accent-wash"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="head-menus-cta">
            <a href={url(locale, 'contact')} class="btn btn-solid w-full justify-center">
              {s.nav.build}
            </a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>

<style>
  /* L'en-tête suit la page. Sans JavaScript ni support du voile, il reste
     exactement ce qu'il était : plein, collé en haut du document. */
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-chalk);
    border-bottom: 1px solid var(--color-rule);
    transition:
      background-color 220ms ease-out,
      border-bottom-color 220ms ease-out;
  }

  html.js .head.is-stuck {
    background: color-mix(in oklab, var(--color-chalk) 88%, transparent);
    border-bottom-color: color-mix(in oklab, var(--color-ink) 16%, transparent);
  }

  @supports (backdrop-filter: blur(1px)) {
    html.js .head.is-stuck {
      background: color-mix(in oklab, var(--color-chalk) 78%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }

  /* La marque s'écrit avec son `i` minuscule ; `.display` met tout en capitales. */
  .head-brand {
    text-transform: none;
  }

  .head-cta {
    padding: 0.55rem 0.95rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .head-menus-cta {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-rule);
  }

  /* Sous 400 px, la ligne porte quatre éléments : marque, bascule de thème,
     langue, menu. Sans resserrage, la pastille de thème de plus faisait
     déborder l'en-tête — et la page se mettait à défiler horizontalement sur
     un écran de 320 px. */
  @media (max-width: 399px) {
    .head-row {
      gap: 0.75rem;
      padding-inline: 1rem;
    }

    .head-actions {
      gap: 0.5rem;
    }

    .head-brand {
      font-size: 1.05rem;
    }

    .head-chip {
      padding-inline: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .head {
      transition: none;
    }
  }
</style>

<script>
  const head = document.querySelector<HTMLElement>('[data-head]');

  if (head) {
    let stuck = false;
    let queued = false;

    const apply = () => {
      queued = false;
      const next = window.scrollY > 8;
      if (next === stuck) return;
      stuck = next;
      head.classList.toggle('is-stuck', next);
    };

    // Un seul cadrage par image : le défilement ne déclenche aucun calcul.
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(apply);
      },
      { passive: true },
    );
    apply();
  }
</script>
