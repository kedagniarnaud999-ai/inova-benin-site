---
/**
 * La marque du site : trois nœuds reliés, PROBLEMS → PRODUCTS → VENTURES.
 * Elle ouvre la section de conviction (§4 du brief) et se retrouve, immobile,
 * au pied de page. `notes` ajoute le commentaire sous chaque mot ; le héros
 * ne montre que les trois mots.
 */
interface Item {
  label: string;
  note?: string;
}

interface Props {
  items: Item[];
  notes?: boolean;
  /** `ink` : posée sur fond sombre ; `chalk` : sur fond clair. */
  tone?: 'ink' | 'chalk';
  class?: string;
}

const { items, notes = true, tone = 'ink', class: className } = Astro.props;
const align = ['start', 'center', 'end'] as const;
---

<div class:list={['flow', `flow-${tone}`, className]} data-flow>
  <div class="flow-rail" aria-hidden="true">
    <svg class="flow-svg" viewBox="0 0 100 2" preserveAspectRatio="none">
      <line
        class="flow-line"
        x1="0.5"
        y1="1"
        x2="99.5"
        y2="1"
        pathLength="100"
        vector-effect="non-scaling-stroke"></line>
    </svg>
    <ul class="flow-dots">
      {items.map((_, i) => <li class="flow-node" style={`--i: ${i}`}></li>)}
    </ul>
  </div>

  <ol class="flow-items">
    {
      items.map((item, i) => (
        <li class="flow-word" style={`--i: ${i}`} data-align={align[i]}>
          <span class="label flow-label">{item.label}</span>
          {notes && item.note && <span class="flow-note">{item.note}</span>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .flow {
    display: grid;
    gap: 1.15rem;
  }

  .flow-rail {
    position: relative;
    height: 13px;
  }

  .flow-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .flow-line {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.45;
  }

  .flow-dots {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .flow-node {
    width: 11px;
    height: 11px;
    border: 1px solid currentColor;
    background: var(--color-chalk);
    animation-fill-mode: both;
    animation-delay: calc(280ms + (var(--i) * 240ms));
  }

  .flow-ink .flow-node {
    background: var(--color-ink);
  }

  .flow-items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    list-style: none;
  }

  .flow-word {
    display: grid;
    gap: 0.3rem;
    animation-fill-mode: both;
    animation-delay: calc(360ms + (var(--i) * 240ms));
  }

  .flow-word[data-align='start'] {
    justify-items: start;
    text-align: left;
  }

  .flow-word[data-align='center'] {
    justify-items: center;
    text-align: center;
  }

  .flow-word[data-align='end'] {
    justify-items: end;
    text-align: right;
  }

  .flow-label {
    font-size: clamp(0.62rem, 1.5vw, 0.78rem);
  }

  .flow-ink .flow-label {
    color: var(--color-chalk);
  }

  .flow-note {
    font-size: 0.86rem;
    line-height: 1.45;
    max-width: 22ch;
  }

  .flow-ink .flow-note {
    color: color-mix(in oklab, var(--color-chalk) 62%, transparent);
  }

  .flow-chalk .flow-note {
    color: var(--color-muted);
  }

  @media (max-width: 30rem) {
    .flow-note {
      display: none;
    }
  }
</style>
