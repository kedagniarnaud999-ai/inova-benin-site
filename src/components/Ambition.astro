---
/**
 * L'ambition en échelle, pas en anneaux (§10 du brief) : cinq barreaux qui
 * montent de Cotonou au-delà, chacun porteur de son qualificatif. Le barreau
 * s'élargit et s'éclaircit à mesure qu'on descend — l'ambition grandit, le
 * horizon s'éloigne. Aucun chiffre inventé : la largeur dit un ordre, pas une
 * mesure.
 */
interface Rung {
  name: string;
  note: string;
}

interface Props {
  rungs: Rung[];
}

const { rungs } = Astro.props;
const ALPHAS = [0.8, 0.66, 0.52, 0.4, 0.3];
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="ladder">
  {
    rungs.map((rung, i) => (
      <li class="rung" data-reveal style={`--d: ${i * 90}ms`}>
        <div class="rung-top">
          <span class="label rung-n">{pad(i + 1)}</span>
          <span class="rung-name">{rung.name}</span>
          <span class="label rung-note">{rung.note}</span>
        </div>
        <span
          class="rung-bar"
          aria-hidden="true"
          style={`--w: ${((i + 1) / rungs.length) * 100}%; --a: ${ALPHAS[i] ?? 0.3}`}></span>
      </li>
    ))
  }
</ol>

<style>
  .ladder {
    display: grid;
    list-style: none;
    border-top: 1px solid color-mix(in oklab, var(--color-chalk) 24%, transparent);
  }

  .rung {
    display: grid;
    gap: 0.7rem;
    padding: 1.05rem 0 1.15rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-chalk) 24%, transparent);
  }

  .rung-top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }

  /* Le premier barreau est le point de départ : il se lit, les autres s'effacent
     à mesure que l'échelle s'éloigne de Cotonou. */
  .rung-n {
    color: color-mix(in oklab, var(--color-chalk) 52%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .rung:first-child .rung-n {
    color: var(--color-chalk);
  }

  .rung-name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 108;
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-chalk);
  }

  .rung-note {
    margin-left: auto;
    text-align: right;
    color: color-mix(in oklab, var(--color-chalk) 58%, transparent);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .rung-bar {
    display: block;
    height: 3px;
    width: var(--w, 20%);
    background: var(--color-chalk);
    opacity: var(--a, 0.8);
  }
</style>
