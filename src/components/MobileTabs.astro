---
import { url, type Locale, type RouteKey } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  route?: RouteKey;
}

const { locale, route } = Astro.props;
const s = t(locale);

/**
 * Quatre entrées, pas la navigation entière : le menu de l'en-tête garde les
 * cinq pages. Les icônes sont tracées ici, aucune police d'icônes n'est
 * chargée pour ça.
 */
const items: { key: RouteKey; label: string; glyph: 'home' | 'lab' | 'studio' | 'contact' }[] = [
  { key: 'home', label: s.nav.home, glyph: 'home' },
  { key: 'lab', label: s.nav.lab, glyph: 'lab' },
  { key: 'studio', label: s.nav.studio, glyph: 'studio' },
  { key: 'contact', label: s.nav.contact, glyph: 'contact' },
];
---

<nav class="tabs" aria-label={s.nav.main}>
  <ul class="tabs-list">
    {
      items.map((item) => {
        const active = item.key === route;
        return (
          <li>
            <a
              href={url(locale, item.key)}
              aria-current={active ? 'page' : undefined}
              class:list={['tab', active && 'is-current']}
            >
              <svg class="tab-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                {
                  item.glyph === 'home' ? (
                    <g stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="3" width="7" height="7" />
                      <rect x="14" y="3" width="7" height="7" />
                      <rect x="3" y="14" width="7" height="7" />
                      <rect x="14" y="14" width="7" height="7" />
                    </g>
                  ) : item.glyph === 'lab' ? (
                    <g stroke="currentColor" stroke-width="1.4">
                      <path d="M12 12 5 5M12 12l7-4M12 12l-2 8" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="5" cy="5" r="1.6" />
                      <circle cx="19" cy="8" r="1.6" />
                      <circle cx="10" cy="20" r="1.6" />
                    </g>
                  ) : item.glyph === 'studio' ? (
                    <g stroke="currentColor" stroke-width="1.4">
                      <path d="M3 8V3h5M21 8V3h-5M3 16v5h5M21 16v5h-5" />
                      <circle cx="12" cy="12" r="3.4" />
                    </g>
                  ) : (
                    <g stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="5" width="18" height="14" />
                      <path d="M3 6l9 7 9-7" />
                    </g>
                  )
                }
              </svg>
              <span class="label tab-label">{item.label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* Pendant le défilement la barre masque une bande de page. Placée après le
     pied de page, elle revient dans le flux en fin de défilement : le pied de
     page se lit alors entièrement, rien d'important ne reste sous la barre. */
  .tabs {
    position: sticky;
    bottom: 0;
    z-index: 40;
    display: none;
    background: var(--color-chalk);
    border-top: 1px solid var(--color-rule);
    padding-bottom: env(safe-area-inset-bottom);
  }

  @media (max-width: 63.99rem) {
    .tabs {
      display: block;
    }
  }

  .tabs-list {
    display: flex;
    align-items: stretch;
    list-style: none;
    padding: 0.35rem 0.5rem 0.3rem;
  }

  .tabs-list li {
    flex: 1 1 0;
    min-width: 0;
  }

  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.24rem;
    min-height: 3.4rem;
    padding: 0.35rem 0.2rem;
    border-top: 2px solid transparent;
    color: var(--color-muted);
    text-decoration: none;
  }

  .is-current {
    border-top-color: var(--accent);
    color: var(--accent-ink);
  }

  .tab-glyph {
    width: 21px;
    height: 21px;
    flex: none;
  }

  .tab-label {
    font-size: 0.56rem;
    letter-spacing: 0.12em;
  }
</style>
