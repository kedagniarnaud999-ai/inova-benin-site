---
import { EXPERIMENTS, type Experiment, type ExperimentShot } from '../content/experiments';
import LabVisual from './LabVisual.astro';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  /** Combien de cartes visuelles entre le projet principal et la grille compacte. */
  secondary?: number;
}

const { locale, secondary = 2 } = Astro.props;
const s = t(locale);
const labels = s.labels;

/**
 * §9 du brief : une hiérarchie, pas six blocs du même poids. Le projet qui porte
 * un problème documenté ouvre la section — c'est celui dont on peut raconter
 * l'origine, et c'est ce qui fait une preuve. Les suivants passent en cartes,
 * le reste en grille compacte.
 */
const lead = EXPERIMENTS.find((e) => e.problem) ?? EXPERIMENTS[0];
const rest = EXPERIMENTS.filter((e) => e.id !== lead.id);
const large = rest.slice(0, secondary);
const small = rest.slice(secondary);

const badgeClass: Record<Experiment['status'], string> = {
  live: 'badge-live',
  preview: 'badge-preview',
  built: 'badge-built',
};
const badgeText: Record<Experiment['status'], string> = {
  live: labels.status_live,
  preview: labels.status_preview,
  built: labels.status_built,
};

const address = (item: Experiment) => item.live ?? item.repo ?? '';
/** L'URL publique telle qu'elle se montre dans le bandeau de la maquette. */
const host = (item: Experiment) => {
  const href = address(item);
  if (!href) return '';
  try {
    return new URL(href).host;
  } catch {
    return href;
  }
};
/** Le navigateur choisit entre les deux largeurs publiées ; on n'invente aucun chiffre. */
const shotAttrs = (shot: ExperimentShot) => ({
  src: shot.wide.src,
  srcset: `${shot.narrow.src} ${shot.narrow.width}w, ${shot.wide.src} ${shot.wide.width}w`,
  sizes: '(min-width: 62rem) 620px, calc(100vw - 2.5rem)',
  width: shot.wide.width,
  height: shot.wide.height,
  alt: '',
  loading: 'lazy',
  decoding: 'async',
} as const);
---

<div class="showcase">
  <!-- 1 — Le projet principal -->
  <article class="lead" data-reveal>
    <a class="frame" href={address(lead)} rel="noopener" aria-label={`${s.cta.seeProduct} — ${lead.name}`}>
      <span class="frame-bar">
        <span class="frame-marks" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="frame-host">{host(lead)}</span>
      </span>
      <span class="frame-screen">
        {
          lead.shot ? (
            <img {...shotAttrs(lead.shot)} />
          ) : (
            <LabVisual kind={lead.visual} uid={`${lead.id}-lead`} />
          )
        }
      </span>
    </a>

    <div class="lead-body">
      <p class="label lead-meta">
        {lead.id} · {lead.sector[locale]}
      </p>
      <h3 class="lead-name display">{lead.name}</h3>
      <p class="lead-promise">{lead.promise[locale]}</p>

      <dl class="notes">
        <div class="note">
          <dt class="label">{labels.problem}</dt>
          <dd>{lead.problem?.[locale]}</dd>
        </div>
        <div class="note">
          <dt class="label">{labels.answer}</dt>
          <dd>{lead.tagline[locale]}</dd>
        </div>
      </dl>

      <ul class="tags" role="list">
        {lead.tags[locale].map((tag) => <li class="chip">{tag}</li>)}
      </ul>

      <p class="lead-cta">
        <a href={address(lead)} rel="noopener" class="btn btn-solid">{s.cta.seeProduct}</a>
      </p>
    </div>
  </article>

  <!-- 2 — Les cartes visuelles -->
  <ul class="large">
    {
      large.map((item, i) => (
        <li class="card" data-reveal style={`--d: ${i * 110}ms`}>
          <a class="card-link" href={address(item)} rel="noopener">
            <div class="card-shot">
              {
                item.shot ? (
                  <img {...shotAttrs(item.shot)} />
                ) : (
                  <LabVisual kind={item.visual} uid={item.id} />
                )
              }
              <span class="card-id label">{item.id}</span>
            </div>

            <div class="card-body">
              <div class="card-head">
                <h3 class="card-name">{item.name}</h3>
                <span class:list={['badge', badgeClass[item.status]]}>{badgeText[item.status]}</span>
              </div>
              <p class="card-promise">{item.promise[locale]}</p>
              <ul class="card-tags" role="list">
                {item.tags[locale].map((tag) => <li class="chip">{tag}</li>)}
              </ul>
              <p class="card-go label">
                {s.cta.seeProduct}
                <svg viewBox="0 0 16 10" class="card-arrow" fill="none" aria-hidden="true">
                  <path d="M0 5h14M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- 3 — Le reste du carnet, en grille compacte -->
  <ul class="grid">
    {
      small.map((item, i) => (
        <li data-reveal style={`--d: ${i * 80}ms`}>
          <a class="tile" href={address(item)} rel="noopener">
            <span class="tile-shot">
              <LabVisual kind={item.visual} uid={`${item.id}-s`} />
            </span>
            <span class="tile-head">
              <span class="tile-name">{item.name}</span>
              <span class:list={['badge', badgeClass[item.status]]}>{badgeText[item.status]}</span>
            </span>
            <span class="tile-promise">{item.promise[locale]}</span>
            <span class="tile-id label">{item.id}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .showcase {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* ── 1. Le projet principal ───────────────────────────────────────────────
     Le cadre n'est pas une capture : c'est une maquette, avec la figure tracée
     du produit derrière un bandeau d'adresse. Le visiteur lit la géométrie du
     produit et son hôte réel, puis juge en cliquant.
     ─────────────────────────────────────────────────────────────────────── */
  .lead {
    display: grid;
    gap: clamp(1.8rem, 3.5vw, 3.25rem);
    border-top: 3px solid var(--color-ink);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 62rem) {
    .lead {
      grid-template-columns: 1.08fr 1fr;
      align-items: start;
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  .frame {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    box-shadow: 0 18px 40px -28px rgb(11 30 45 / 0.55);
    transition: transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .frame:hover,
  .frame:focus-visible {
    transform: translateY(-4px);
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-chalk) 22%, transparent);
  }

  .frame-marks {
    display: inline-flex;
    gap: 5px;
  }

  .frame-marks i {
    width: 6px;
    height: 6px;
    border: 1px solid color-mix(in oklab, var(--color-chalk) 45%, transparent);
  }

  .frame-host {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: color-mix(in oklab, var(--color-chalk) 72%, transparent);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .frame-screen {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .frame-screen :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .frame:hover .frame-screen :global(svg),
  .frame:focus-visible .frame-screen :global(svg) {
    transform: scale(1.03);
  }

  .frame-screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .frame:hover .frame-screen :global(img),
  .frame:focus-visible .frame-screen :global(img) {
    transform: scale(1.03);
  }

  .lead-body {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  @media (min-width: 62rem) {
    .lead-body {
      padding-top: 0.2rem;
    }
  }

  .lead-meta {
    color: var(--accent-ink);
  }

  .lead-name {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    letter-spacing: -0.03em;
    line-height: 0.92;
  }

  .lead-promise {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100;
    font-size: clamp(1.1rem, 1.9vw, 1.35rem);
    line-height: 1.35;
    color: var(--color-ink);
    max-width: 34ch;
  }

  .notes {
    display: grid;
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    margin-top: 0.6rem;
  }

  .note {
    background: var(--color-chalk);
    display: grid;
    gap: 0.35rem;
    padding: 1.05rem 1.15rem 1.2rem;
  }

  .note dt {
    color: var(--accent-ink);
  }

  .note dd {
    font-size: 0.98rem;
    line-height: 1.62;
    color: var(--color-muted);
    max-width: 52ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    padding: 0.28rem 0.5rem;
  }

  .lead-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.7rem;
  }

  /* ── 2. Les cartes visuelles ────────────────────────────────────────────── */
  .large {
    display: grid;
    gap: 1px;
    background: var(--color-rule);
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 62rem) {
    .large {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    background: var(--color-chalk);
  }

  .card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* Profondeur légère : la figure respire, la carte se soulève d'un cheveu. */
  .card-shot {
    position: relative;
    overflow: hidden;
    aspect-ratio: 8 / 5;
    background: var(--color-ink);
  }

  .card-shot :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .card-link:hover .card-shot :global(svg),
  .card-link:focus-visible .card-shot :global(svg) {
    transform: scale(1.035);
  }

  .card-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .card-link:hover .card-shot :global(img),
  .card-link:focus-visible .card-shot :global(img) {
    transform: scale(1.035);
  }

  .card-id {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-ink);
    color: var(--color-chalk);
    border: 1px solid color-mix(in oklab, var(--color-chalk) 26%, transparent);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem 1.5rem 1.8rem;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .card-name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 108;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .card-promise {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100;
    font-size: 1.06rem;
    line-height: 1.35;
    color: var(--color-ink);
    max-width: 34ch;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .card-link:hover .chip {
    border-color: var(--accent-ink);
  }

  .card-go {
    margin-top: auto;
    padding-top: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent-ink);
  }

  .card-arrow {
    width: 16px;
    height: 10px;
    transition: transform 240ms ease-out;
  }

  .card-link:hover .card-arrow,
  .card-link:focus-visible .card-arrow {
    transform: translateX(5px);
  }

  /* ── 3. La grille compacte ──────────────────────────────────────────────── */
  .grid {
    display: grid;
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tile {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    background: var(--color-chalk);
    padding: 1.15rem 1.15rem 1.35rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
    transition: background-color 200ms ease-out;
  }

  .tile:hover,
  .tile:focus-visible {
    background: var(--accent-wash);
  }

  .tile-shot {
    display: block;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    border: 1px solid var(--color-rule);
  }

  .tile-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tile-name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 106;
    font-size: 1.15rem;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .tile-promise {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .tile-id {
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--accent-ink);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted);
  }

  .badge::before {
    content: '';
    width: 7px;
    height: 7px;
    border: 1px solid var(--accent-ink);
  }

  .badge-live::before {
    background: var(--accent);
  }

  /* Le troisième statut n'est ni plein ni vide : le point est à demi rempli. */
  .badge-preview::before {
    background: linear-gradient(90deg, var(--accent) 50%, transparent 50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .frame-screen :global(svg),
    .frame-screen :global(img),
    .card-shot :global(svg),
    .card-shot :global(img),
    .card-arrow,
    .tile {
      transition: none;
    }

    .frame:hover,
    .frame:focus-visible {
      transform: none;
    }
  }
</style>
