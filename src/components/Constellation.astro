---
import { SKILLS } from '../i18n/pages/home';

interface Props {
  /** libellé du centre : « équipe cœur » dans la langue de la page */
  coreLabel: string;
  coreName: string;
  /** titre accessible du réseau */
  listLabel: string;
}

const { coreLabel, coreName, listLabel } = Astro.props;

/**
 * Anneau calculé au build, pas à la main : les mêmes coordonnées nourrissent
 * les traits du SVG et la position des nœuds, donc le dessin ne peut pas
 * se décaler du texte. Ellipse volontairement plus large que haute : c'est
 * en haut et en bas que les libellés ont besoin de place.
 */
const RX = 33;
const RY = 30;
const N = SKILLS.length;

const nodes = SKILLS.map((label, i) => {
  const angle = (-90 + (360 / N) * i) * (Math.PI / 180);
  const x = 50 + RX * Math.cos(angle);
  const y = 50 + RY * Math.sin(angle);
  const side = Math.cos(angle) > 0.28 ? 'out' : Math.cos(angle) < -0.28 ? 'in' : 'mid';
  return { label, x, y, side };
});
---

<div class="net">
  <svg class="net-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {
      nodes.map((n) => (
        <line
          x1="50"
          y1="50"
          x2={n.x}
          y2={n.y}
          vector-effect="non-scaling-stroke"></line>
      ))
    }
    <circle cx="50" cy="50" r="2.4" vector-effect="non-scaling-stroke"></circle>
  </svg>

  <p class="net-core" aria-hidden="true">
    <span class="net-core-label label">{coreLabel}</span>
    <span class="net-core-name">{coreName}</span>
  </p>

  <ul class="net-nodes" data-reveal>
    <li class="net-title label" style="--d: 0ms">{listLabel}</li>
    {
      nodes.map((n, i) => (
        <li class:list={['net-node', `side-${n.side}`]} style={`--x: ${n.x}%; --y: ${n.y}%; --d: ${60 + i * 45}ms`}>
          <span class="net-dot" aria-hidden="true"></span>
          <span class="net-label">{n.label}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .net {
    position: relative;
    aspect-ratio: 1.25;
    min-height: 26rem;
    color: var(--color-ink);
  }

  .net-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .net-lines line {
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .net-lines circle {
    fill: var(--color-chalk);
    stroke: var(--accent-ink);
    stroke-width: 1.4;
  }

  .net-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    text-align: center;
    max-width: 13rem;
    background: var(--color-chalk);
    padding: 0.4rem 0.6rem;
  }

  .net-core-label {
    color: var(--accent-ink);
  }

  .net-core-name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 108;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .net-nodes {
    position: absolute;
    inset: 0;
    list-style: none;
  }

  .net-title {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--color-muted);
  }

  .net-node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .net-dot {
    order: 0;
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--color-chalk);
    border: 1px solid var(--accent-ink);
    border-radius: 50%;
  }

  .net-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    max-width: 10ch;
    color: var(--color-ink);
  }

  /* Le point reste sur sa position calculée ; le libellé part du bon côté. */
  .side-out .net-label {
    text-align: left;
  }

  .side-in {
    flex-direction: row-reverse;
  }

  .side-in .net-label {
    text-align: right;
  }

  .side-mid {
    flex-direction: column;
    gap: 0.3rem;
    transform: translateX(-50%);
  }

  .side-mid .net-label {
    text-align: center;
    max-width: 14ch;
  }

  /* Sur petit écran, le réseau devient une liste : mêmes éléments, même ordre,
     aucun doublon de contenu à maintenir. */
  @media (max-width: 47.99rem) {
    .net {
      aspect-ratio: auto;
      min-height: 0;
    }
    .net-lines,
    .net-core,
    .net-dot {
      display: none;
    }
    .net-nodes {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem 0.5rem;
      border-top: 1px solid var(--color-rule);
      padding-top: 1.1rem;
    }
    .net-title {
      position: static;
      width: 100%;
    }
    .net-node,
    .net-node.side-in,
    .net-node.side-mid {
      position: static;
      transform: none;
      flex-direction: row;
      border: 1px solid var(--color-rule);
      padding: 0.35rem 0.6rem;
    }
    .net-label,
    .side-in .net-label,
    .side-mid .net-label {
      text-align: left;
      max-width: none;
    }
  }
</style>
