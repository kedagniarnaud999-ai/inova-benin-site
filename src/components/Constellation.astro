---
import type { Locale } from '../i18n/config';
import { skillNames } from '../i18n/skills';

interface Props {
  locale: Locale;
  /** libellé du centre : « équipe cœur » dans la langue de la page */
  coreLabel: string;
  coreName: string;
  /** titre accessible du réseau */
  listLabel: string;
  /** qualifier posé en face du titre : « À la demande » */
  onDemand?: string;
}

const { locale, coreLabel, coreName, listLabel, onDemand } = Astro.props;

/**
 * Anneau calculé au build, pas à la main : les mêmes coordonnées nourrissent
 * les traits du SVG et la position des nœuds, donc le dessin ne peut pas
 * se décaler du texte. Ellipse volontairement plus large que haute : c'est
 * en haut et en bas que les libellés ont besoin de place.
 */
const RX = 33;
const RY = 30;
const names = skillNames(locale);
const N = names.length;

const nodes = names.map((label, i) => {
  const angle = (-90 + (360 / N) * i) * (Math.PI / 180);
  const x = 50 + RX * Math.cos(angle);
  const y = 50 + RY * Math.sin(angle);
  const side = Math.cos(angle) > 0.28 ? 'out' : Math.cos(angle) < -0.28 ? 'in' : 'mid';
  return { label, x, y, side };
});
---

<div class="net">
  <div class="net-frame">
    <svg class="net-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {
        nodes.map((n) => (
          <line
            x1="50"
            y1="50"
            x2={n.x}
            y2={n.y}
            vector-effect="non-scaling-stroke"></line>
        ))
      }
      <circle cx="50" cy="50" r="2.4" vector-effect="non-scaling-stroke"></circle>
    </svg>

    <p class="net-core" aria-hidden="true">
      <span class="net-core-label label">{coreLabel}</span>
      <span class="net-core-name">{coreName}</span>
    </p>

    <ul class="net-nodes" data-reveal>
      <li class="net-title">
        <span class="label">{listLabel}</span>
        {onDemand && <span class="label net-hint">{onDemand}</span>}
      </li>
      {
        nodes.map((n) => (
          <li class:list={['net-node', `side-${n.side}`]} style={`--x: ${n.x}%; --y: ${n.y}%`}>
            <span class="net-dot" aria-hidden="true"></span>
            <span class="net-label">{n.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /**
   * Deux régimes pour les mêmes onze compétences. La bascule se prend sur la
   * largeur RÉELLE de la colonne, pas sur celle de l'écran : l'anneau est
   * réglé pour respirer à partir de 40 rem, en dessous ses libellés se
   * touchent et la liste de pastilles reprend le dessin. Un conteneur ne se
   * requête pas lui-même : la hauteur de l'anneau est donc posée sur le cadre
   * intérieur, sinon tous les nœuds s'empilent sur un conteneur de 0 px.
   */
  .net {
    container-type: inline-size;
  }

  .net-frame {
    position: relative;
    color: var(--color-ink);
  }

  .net-lines,
  .net-core,
  .net-dot {
    display: none;
  }

  .net-nodes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    list-style: none;
    border-top: 1px solid var(--color-rule);
    padding-top: 1.1rem;
  }

  .net-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    color: var(--color-muted);
  }

  .net-hint {
    text-transform: none;
    letter-spacing: 0.06em;
    font-size: 0.66rem;
    flex: none;
  }

  .net-node {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
  }

  .net-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }

  @container (min-width: 40rem) {
    .net-frame {
      aspect-ratio: 1.25;
      min-height: 26rem;
    }

    .net-lines {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .net-lines line {
      stroke: var(--color-rule);
      stroke-width: 1;
    }

    .net-lines circle {
      fill: var(--color-chalk);
      stroke: var(--accent-ink);
      stroke-width: 1.4;
    }

    .net-core {
      display: grid;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      justify-items: center;
      gap: 0.2rem;
      text-align: center;
      max-width: 13rem;
      background: var(--color-chalk);
      padding: 0.4rem 0.6rem;
    }

    .net-core-label {
      color: var(--accent-ink);
    }

    .net-core-name {
      font-family: var(--font-display);
      font-variation-settings: 'wdth' 108;
      font-size: 0.95rem;
      letter-spacing: 0.02em;
      line-height: 1.2;
    }

    .net-nodes {
      position: absolute;
      inset: 0;
      display: block;
      border-top: 0;
      padding-top: 0;
    }

    .net-title {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      width: auto;
    }

    .net-dot {
      display: block;
      width: 7px;
      height: 7px;
      flex: none;
      background: var(--color-chalk);
      border: 1px solid var(--accent-ink);
      border-radius: 50%;
    }

    .net-node {
      position: absolute;
      left: var(--x);
      top: var(--y);
      display: flex;
      align-items: center;
      gap: 0.45rem;
      border: 0;
      border-radius: 0;
      padding: 0;
    }

    .net-label {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      max-width: 10ch;
    }

    /* Le point reste sur sa position calculée ; le libellé part du bon côté. */
    .side-out {
      transform: translateY(-50%);
    }

    .side-out .net-label {
      text-align: left;
    }

    .side-in {
      flex-direction: row-reverse;
      transform: translate(-100%, -50%);
    }

    .side-in .net-label {
      text-align: right;
    }

    .side-mid {
      flex-direction: column;
      gap: 0.3rem;
      transform: translateX(-50%);
    }

    .side-mid .net-label {
      text-align: center;
      max-width: 14ch;
    }
  }
</style>
